#!/usr/bin/env bash
#
# mux — one launcher for AI coding CLIs and the providers behind them.
#
#   mux                              status: which agents/providers/commands you have
#   mux codex -p stepfun             run codex against StepFun's Step Plan API
#   mux claude -p glm                run Claude Code against z.ai GLM
#   mux gen stepfun                  write ~/.local/bin/stepfun for that combination
#
# Config lives in ${LAUNCHER_HOME:-~/.config/mux}:
#   config.json    shareable; providers, agents, generated commands
#   secrets.json   mode 600; API keys only
#
# Requires bash 3.2+ and jq. Launching codex additionally needs codex-cli >= 0.155
# (for `--profile`). No key is ever echoed.

set -euo pipefail

VERSION="1.0.0"

LAUNCHER_HOME="${LAUNCHER_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/mux}"
CONFIG_FILE="${MUX_CONFIG:-$LAUNCHER_HOME/config.json}"
SECRETS_FILE="${MUX_SECRETS:-$LAUNCHER_HOME/secrets.json}"
BIN_DIR="${MUX_BIN_DIR:-$HOME/.local/bin}"
CODEX_DIR="${CODEX_HOME:-$HOME/.codex}"

DRY_RUN=0
LAUNCH_PROVIDER=""
LAUNCH_MODEL_AGENT=""
BASE_INSTRUCTIONS='You are Codex, a helpful coding agent. Read code carefully before changing it and keep responses concise.'

# Agents probed by `mux status`. Config entries and provider defaults are added on top.
KNOWN_AGENTS=(codex claude gemini agy cursor-agent qwen iflow opencode crush amp droid)

die() { printf 'mux: %s\n' "$*" >&2; exit 1; }
note() { printf '%s\n' "$*" >&2; }

# --- small helpers ------------------------------------------------------------

self_path() {
  local p="$0" r d
  case "$p" in
    */*) ;;
    *) p="$(command -v -- "$p" 2>/dev/null || printf '%s' "$p")" ;;
  esac
  r="$(readlink -f "$p" 2>/dev/null || true)"
  [ -n "$r" ] && p="$r"
  case "$p" in
    /*) ;;
    *)  d="$(cd -- "$(dirname -- "$p")" 2>/dev/null && pwd)" && p="$d/$(basename -- "$p")" ;;
  esac
  printf '%s\n' "$p"
}
SELF_PATH="$(self_path)"

# stdin -> destination, atomically (temp file in the same directory, then rename).
atomic_write() {
  local dest="$1" mode="$2" dir tmp
  dir="$(dirname -- "$dest")"
  mkdir -p "$dir" || die "cannot create $dir"
  tmp="$(mktemp "$dir/.mux.XXXXXX")" || die "cannot write into $dir"
  cat >"$tmp"
  chmod "$mode" "$tmp"
  mv -f "$tmp" "$dest" || die "cannot replace $dest"
}

# cfg <jq-filter> [jq args...] -> raw output; empty when config is absent or broken.
cfg() {
  [ -f "$CONFIG_FILE" ] || return 0
  jq -r "$@" "$CONFIG_FILE" 2>/dev/null || true
}

secrets_get() {
  [ -f "$SECRETS_FILE" ] || return 0
  jq -r --arg p "$1" '.[$p] // empty' "$SECRETS_FILE" 2>/dev/null || true
}

ensure_config() {
  if [ ! -f "$CONFIG_FILE" ]; then
    default_config | atomic_write "$CONFIG_FILE" 600
    note "created $CONFIG_FILE"
  fi
  if [ ! -f "$SECRETS_FILE" ]; then
    printf '{}\n' | atomic_write "$SECRETS_FILE" 600
    note "created $SECRETS_FILE (API keys)"
  fi
  chmod 600 "$SECRETS_FILE" 2>/dev/null || true
}

require_jq() {
  command -v jq >/dev/null 2>&1 || die "jq is required but not installed"
}

require_codex_profile_support() {
  command -v codex >/dev/null 2>&1 || die "codex is not on PATH"
  case "$(codex --help 2>&1 || true)" in
    *--profile*) return 0 ;;
    *) die "this codex has no --profile option (needs codex-cli 0.155.1 or newer)" ;;
  esac
}

